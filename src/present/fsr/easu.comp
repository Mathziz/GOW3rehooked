#version 450
#extension GL_GOOGLE_include_directive : require
layout(push_constant) uniform Constants { uvec4 con0; uvec4 con1; uvec4 con2; uvec4 con3; };
#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
layout(set = 0, binding = 0) uniform sampler2D input_image;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D output_image;
#define FSR_EASU_F 1
AF4 FsrEasuRF(AF2 p) { return textureGather(input_image, p, 0); }
AF4 FsrEasuGF(AF2 p) { return textureGather(input_image, p, 1); }
AF4 FsrEasuBF(AF2 p) { return textureGather(input_image, p, 2); }
#include "ffx_fsr1.h"
void Filter(uvec2 pos) {
    if (any(greaterThanEqual(pos, uvec2(imageSize(output_image))))) return;
    vec3 c;
    FsrEasuF(c, pos, con0, con1, con2, con3);
    imageStore(output_image, ivec2(pos), vec4(c, 1));
}
layout(local_size_x = 64) in;
void main() {
    uvec2 pos = ARmp8x8(gl_LocalInvocationID.x) + (gl_WorkGroupID.xy << 4u);
    Filter(pos); pos.x += 8u; Filter(pos); pos.y += 8u; Filter(pos); pos.x -= 8u; Filter(pos);
}
